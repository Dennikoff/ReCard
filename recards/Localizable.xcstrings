            "value": "Wrong"
          }
        }
      }
    },
    "Правильное написание: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct spelling: %@"
          }
        }
      }
    },
    "Засчитать как верный": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count as correct"
          }
        }
      }
    },
    "Знаю": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I know it"
          }
        }
      }
    },
    "Не знаю": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't know"
          }
        }
      }
    },
    "«Знаю» нужно будет подтвердить: приложение попросит напечатать слово.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I know it” must be confirmed: the app will ask you to type the word."
          }
        }
      }
    },
    "Без единой ошибки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flawless"
          }
        }
      }
    },
    "Сессия завершена": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session complete"
          }
        }
      }
    },
    "Нечего повторять": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to review"
          }
        }
      }
    },
    "Все карточки на сегодня уже пройдены.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All cards for today are done."
          }
        }
